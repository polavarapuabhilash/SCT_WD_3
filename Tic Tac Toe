<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tic Tac Toe</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif'],
                    },
                    colors: {
                        primary: '#6366f1',
                        secondary: '#ec4899',
                        dark: '#1e293b',
                        light: '#f8fafc',
                    }
                }
            }
        }
    </script>
    
    <style>
        :root {
            --cell-size: 100px;
            --mark-size: calc(var(--cell-size) * 0.9);
        }

        @media (max-width: 640px) {
            :root {
                --cell-size: 80px;
            }
        }

        body {
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.1);
        }
        
        .dark .glass-panel {
            background: rgba(30, 41, 59, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .board {
            display: grid;
            grid-template-columns: repeat(3, auto);
            gap: 10px;
            justify-content: center;
            align-content: center;
        }

        .cell {
            width: var(--cell-size);
            height: var(--cell-size);
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 3rem;
            cursor: pointer;
            transition: all 0.2s ease-in-out;
            position: relative;
        }

        .cell:hover {
            transform: scale(1.05);
            box-shadow: inset 0 0 10px rgba(0,0,0,0.1);
        }
        
        .dark .cell:hover {
            box-shadow: inset 0 0 10px rgba(255,255,255,0.1);
        }

        .cell.x::before,
        .cell.x::after,
        .cell.circle::before,
        .cell.circle::after {
            background-color: currentColor;
        }

        .cell.x::before,
        .cell.x::after {
            content: '';
            position: absolute;
            width: calc(var(--mark-size) * .15);
            height: var(--mark-size);
            background-color: #ec4899; /* Pink for X */
            border-radius: 5px;
            animation: drawX 0.3s ease-out forwards;
        }

        .cell.x::before {
            transform: rotate(45deg);
        }

        .cell.x::after {
            transform: rotate(-45deg);
        }

        @keyframes drawX {
            0% { height: 0; opacity: 0; }
            100% { height: var(--mark-size); opacity: 1; }
        }

        .cell.circle::before,
        .cell.circle::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            animation: drawO 0.3s ease-out forwards;
        }

        .cell.circle::before {
            width: var(--mark-size);
            height: var(--mark-size);
            background-color: #6366f1; /* Indigo for O */
        }

        .cell.circle::after {
            width: calc(var(--mark-size) * .7);
            height: calc(var(--mark-size) * .7);
            background-color: white; /* Matches light mode cell bg */
        }
        
        .dark .cell.circle::after {
            background-color: #1e293b; /* Matches dark mode cell bg */
        }

        @keyframes drawO {
            0% { transform: scale(0); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        .cell.x, .cell.circle {
            cursor: not-allowed;
            transform: scale(1);
        }
        
        .cell.x:hover, .cell.circle:hover {
            transform: scale(1);
        }

        .winning-cell {
            animation: pulse 1s infinite alternate;
            background-color: rgba(34, 197, 94, 0.2) !important; /* Light green tint */
            border: 2px solid #22c55e;
        }

        @keyframes pulse {
            from { transform: scale(1); }
            to { transform: scale(1.05); }
        }

        .modal-enter {
            animation: slideIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        @keyframes slideIn {
            0% { transform: translateY(-50px) scale(0.9); opacity: 0; }
            100% { transform: translateY(0) scale(1); opacity: 1; }
        }

        /* Custom toggle switch styling */
        .toggle-checkbox:checked {
            right: 0;
            border-color: #68D391;
        }
        .toggle-checkbox:checked + .toggle-label {
            background-color: #68D391;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-indigo-100 to-purple-100 dark:from-slate-900 dark:to-slate-800 text-slate-800 dark:text-slate-200 min-h-screen flex flex-col transition-colors duration-300">

    <nav class="w-full glass-panel fixed top-0 z-50 px-6 py-4 flex justify-between items-center rounded-b-2xl">
        <div class="flex items-center gap-3">
            <i class="fa-solid fa-gamepad text-2xl text-primary"></i>
            <h1 class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-primary to-secondary">Tic Tac Toe</h1>
        </div>
        
        <!-- Dark Mode Toggle -->
        <div class="flex items-center gap-2">
            <i class="fa-solid fa-sun text-yellow-500"></i>
            <div class="relative inline-block w-10 mr-2 align-middle select-none transition duration-200 ease-in">
                <input type="checkbox" name="toggle" id="theme-toggle" class="toggle-checkbox absolute block w-5 h-5 rounded-full bg-white border-4 appearance-none cursor-pointer z-10 transition-transform duration-300 ease-in-out" />
                <label for="theme-toggle" class="toggle-label block overflow-hidden h-5 rounded-full bg-gray-300 cursor-pointer"></label>
            </div>
            <i class="fa-solid fa-moon text-blue-400"></i>
        </div>
    </nav>

    <main class="flex-grow flex flex-col items-center justify-center pt-24 pb-10 px-4">
        
        <!-- Game Configuration Panel -->
        <div class="glass-panel p-6 rounded-2xl w-full max-w-md mb-8 fade-in">
            <h2 class="text-lg font-semibold mb-4 text-center">Game Settings</h2>
            
            <div class="flex flex-col gap-4">
                <!-- Mode Selection -->
                <div class="flex flex-wrap justify-center gap-3">
                    <button id="btn-pvp" class="px-4 py-2 rounded-lg font-medium transition-all duration-200 bg-primary text-white shadow-md hover:bg-indigo-600 flex items-center gap-2 active-mode">
                        <i class="fa-solid fa-user-group"></i> PvP
                    </button>
                    <button id="btn-pvc" class="px-4 py-2 rounded-lg font-medium transition-all duration-200 bg-white dark:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-600 flex items-center gap-2">
                        <i class="fa-solid fa-robot"></i> PvAI
                    </button>
                </div>

                <!-- Player Marker Selection (Hidden by default) -->
                <div id="player-marker-container" class="hidden flex flex-col items-center gap-2 mt-2 transition-all duration-300">
                    <span class="text-sm font-medium">Play as:</span>
                    <div class="flex gap-3 bg-slate-100 dark:bg-slate-700 p-1 rounded-lg">
                        <button id="btn-play-x" class="px-4 py-1 rounded-md text-sm font-bold transition-all duration-200 bg-secondary text-white shadow">X</button>
                        <button id="btn-play-o" class="px-4 py-1 rounded-md text-sm font-bold transition-all duration-200 text-slate-500 hover:text-slate-700 dark:text-slate-300 dark:hover:text-white">O</button>
                    </div>
                </div>

                <!-- AI Difficulty Selection (Hidden by default) -->
                <div id="ai-difficulty-container" class="hidden flex flex-col items-center gap-2 mt-2 transition-all duration-300">
                    <span class="text-sm font-medium">AI Difficulty:</span>
                    <div class="flex gap-3">
                        <button id="btn-easy" class="px-3 py-1 rounded-md text-sm transition-all duration-200 bg-green-500 text-white shadow hover:bg-green-600">Easy</button>
                        <button id="btn-moderate" class="px-3 py-1 rounded-md text-sm transition-all duration-200 bg-white dark:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-600">Moderate</button>
                        <button id="btn-hard" class="px-3 py-1 rounded-md text-sm transition-all duration-200 bg-white dark:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-600">Impossible</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="glass-panel px-8 py-4 rounded-xl flex justify-between items-center w-full max-w-md mb-6 shadow-lg">
            <div class="text-center flex flex-col items-center">
                <span id="player-x-label" class="text-xs uppercase font-bold text-slate-500 dark:text-slate-400">Player (X)</span>
                <span id="score-x" class="text-2xl font-bold text-secondary">0</span>
            </div>
            <div class="text-center flex flex-col items-center">
                <span class="text-xs uppercase font-bold text-slate-500 dark:text-slate-400">Ties</span>
                <span id="score-ties" class="text-xl font-bold text-slate-400">0</span>
            </div>
            <div class="text-center flex flex-col items-center">
                <span id="player-o-label" class="text-xs uppercase font-bold text-slate-500 dark:text-slate-400">Player (O)</span>
                <span id="score-o" class="text-2xl font-bold text-primary">0</span>
            </div>
        </div>

        <div class="glass-panel p-6 sm:p-8 rounded-3xl shadow-xl flex flex-col items-center">
            
            <!-- Turn Indicator -->
            <div class="mb-6 py-2 px-6 bg-white dark:bg-slate-800 rounded-full shadow-inner flex items-center gap-3">
                <span id="turn-indicator" class="font-semibold text-lg flex items-center gap-2">
                    <span class="text-secondary"><i class="fa-solid fa-x"></i></span> Turn
                </span>
            </div>

            <!-- The Grid -->
            <div class="board bg-slate-200 dark:bg-slate-700 p-2 rounded-2xl" id="board">
                <div class="cell bg-white dark:bg-slate-800" data-cell></div>
                <div class="cell bg-white dark:bg-slate-800" data-cell></div>
                <div class="cell bg-white dark:bg-slate-800" data-cell></div>
                <div class="cell bg-white dark:bg-slate-800" data-cell></div>
                <div class="cell bg-white dark:bg-slate-800" data-cell></div>
                <div class="cell bg-white dark:bg-slate-800" data-cell></div>
                <div class="cell bg-white dark:bg-slate-800" data-cell></div>
                <div class="cell bg-white dark:bg-slate-800" data-cell></div>
                <div class="cell bg-white dark:bg-slate-800" data-cell></div>
            </div>

            <!-- Controls -->
            <div class="mt-8 flex gap-4">
                <button id="restartButton" class="px-6 py-2 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 rounded-lg font-medium transition-colors flex items-center gap-2 shadow-sm">
                    <i class="fa-solid fa-rotate-right"></i> Restart Game
                </button>
                <button id="resetScoresButton" class="px-6 py-2 bg-red-100 text-red-600 dark:bg-red-900/30 dark:text-red-400 hover:bg-red-200 dark:hover:bg-red-900/50 rounded-lg font-medium transition-colors flex items-center gap-2 shadow-sm">
                    <i class="fa-solid fa-trash-can"></i> Reset Scores
                </button>
            </div>
        </div>
    </main>

    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden flex justify-center items-center" id="resultModal">
        <div class="bg-white dark:bg-slate-800 p-8 rounded-2xl shadow-2xl max-w-sm w-full mx-4 text-center border border-slate-200 dark:border-slate-700" id="modalContent">
            
            <div id="winnerIcon" class="text-6xl mb-4 h-20 flex items-center justify-center">
                <!-- Icon injected via JS -->
            </div>
            
            <h2 class="text-3xl font-bold mb-2 text-slate-800 dark:text-white" id="resultMessage">X Wins!</h2>
            <p class="text-slate-500 dark:text-slate-400 mb-6" id="resultSubtext">Great game played.</p>
            
            <button id="nextRoundButton" class="w-full py-3 bg-gradient-to-r from-primary to-secondary text-white rounded-xl font-bold text-lg hover:opacity-90 transition-opacity shadow-lg">
                Play Next Round
            </button>
        </div>
    </div>

    <footer class="py-4 text-center text-sm text-slate-500 dark:text-slate-400 glass-panel mt-auto">
        Designed with <i class="fa-solid fa-heart text-red-500"></i> using HTML, Tailwind CSS & Vanilla JS
    </footer>

    <!-- Audio Elements for Sound Effects -->
    <audio id="clickSound" src="https://assets.mixkit.co/active_storage/sfx/2568/2568-preview.mp3" preload="auto"></audio>
    <audio id="winSound" src="https://assets.mixkit.co/active_storage/sfx/2000/2000-preview.mp3" preload="auto"></audio>
    <audio id="drawSound" src="https://assets.mixkit.co/active_storage/sfx/2573/2573-preview.mp3" preload="auto"></audio>

    <script>
        const X_CLASS = 'x';
        const CIRCLE_CLASS = 'circle';
        const WINNING_COMBINATIONS = [
            [0, 1, 2], [3, 4, 5], [6, 7, 8], // Rows
            [0, 3, 6], [1, 4, 7], [2, 5, 8], // Columns
            [0, 4, 8], [2, 4, 6]             // Diagonals
        ];

        // DOM Elements
        const cellElements = document.querySelectorAll('[data-cell]');
        const board = document.getElementById('board');
        const turnIndicator = document.getElementById('turn-indicator');
        const restartButton = document.getElementById('restartButton');
        const resetScoresButton = document.getElementById('resetScoresButton');
        
        // Modal Elements
        const resultModal = document.getElementById('resultModal');
        const modalContent = document.getElementById('modalContent');
        const resultMessage = document.getElementById('resultMessage');
        const resultSubtext = document.getElementById('resultSubtext');
        const nextRoundButton = document.getElementById('nextRoundButton');
        const winnerIcon = document.getElementById('winnerIcon');
        
        // Settings Elements
        const btnPvp = document.getElementById('btn-pvp');
        const btnPvc = document.getElementById('btn-pvc');
        const aiDifficultyContainer = document.getElementById('ai-difficulty-container');
        const btnEasy = document.getElementById('btn-easy');
        const btnModerate = document.getElementById('btn-moderate');
        const btnHard = document.getElementById('btn-hard');
        const playerXLabel = document.getElementById('player-x-label');
        const playerOLabel = document.getElementById('player-o-label');
        const themeToggle = document.getElementById('theme-toggle');
        const btnPlayX = document.getElementById('btn-play-x');
        const btnPlayO = document.getElementById('btn-play-o');
        const playerMarkerContainer = document.getElementById('player-marker-container');

        // Score Elements
        const scoreXEl = document.getElementById('score-x');
        const scoreOEl = document.getElementById('score-o');
        const scoreTiesEl = document.getElementById('score-ties');

        // Audio Elements
        const clickSound = document.getElementById('clickSound');
        const winSound = document.getElementById('winSound');
        const drawSound = document.getElementById('drawSound');

        // Game State Variables
        let circleTurn;
        let gameMode = 'pvp'; // 'pvp' or 'pvc'
        let aiDifficulty = 'easy'; // 'easy' or 'hard'
        let userMarker = 'x'; // 'x' or 'circle'
        let aiMarker = 'circle';
        let isGameActive = true;
        let scores = { x: 0, o: 0, ties: 0 };

        // Load scores and theme from local storage
        loadSettings();
        
        // Theme toggle listener
        themeToggle.addEventListener('change', () => {
            if (themeToggle.checked) {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            } else {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            }
        });

        // Mode Selection Listeners
        btnPvp.addEventListener('click', () => setGameMode('pvp'));
        btnPvc.addEventListener('click', () => setGameMode('pvc'));
        
        // Difficulty Selection Listeners
        btnEasy.addEventListener('click', () => setAiDifficulty('easy'));
        btnModerate.addEventListener('click', () => setAiDifficulty('moderate'));
        btnHard.addEventListener('click', () => setAiDifficulty('hard'));

        // Marker Selection Listeners
        btnPlayX.addEventListener('click', () => setPlayerMarker('x'));
        btnPlayO.addEventListener('click', () => setPlayerMarker('circle'));

        // Game Action Listeners
        restartButton.addEventListener('click', startGame);
        nextRoundButton.addEventListener('click', () => {
            closeModal();
            startGame();
        });
        resetScoresButton.addEventListener('click', resetScores);

        // Initialize Game
        startGame();

        function startGame() {
            circleTurn = false;
            isGameActive = true;
            updateTurnIndicator();
            
            cellElements.forEach(cell => {
                cell.classList.remove(X_CLASS);
                cell.classList.remove(CIRCLE_CLASS);
                cell.classList.remove('winning-cell');
                cell.textContent = '';
                cell.removeEventListener('click', handleClick);
                cell.addEventListener('click', handleClick, { once: true });
            });
            
            // If playing against AI and AI goes first
            if (gameMode === 'pvc' && aiMarker === 'x') {
                isGameActive = false; // Disable user clicking while AI thinks
                setTimeout(makeAiMove, 500);
            }
        }

        function handleClick(e) {
            if (!isGameActive) return;
            
            const cell = e.target;
            const currentClass = circleTurn ? CIRCLE_CLASS : X_CLASS;
            
            // Play sound
            playSound(clickSound);
            
            placeMark(cell, currentClass);
            
            if (checkWin(currentClass)) {
                endGame(false);
            } else if (isDraw()) {
                endGame(true);
            } else {
                swapTurns();
                updateTurnIndicator();
                
                if (gameMode === 'pvc') {
                    const isAiTurn = (!circleTurn && aiMarker === 'x') || (circleTurn && aiMarker === 'circle');
                    if (isAiTurn && isGameActive) {
                        isGameActive = false; // Disable clicking while AI thinks
                        setTimeout(makeAiMove, 500); // Artificial delay for realism
                    }
                }
            }
        }

        function placeMark(cell, currentClass) {
            cell.classList.add(currentClass);
        }

        function swapTurns() {
            circleTurn = !circleTurn;
        }

        function updateTurnIndicator() {
            if (circleTurn) {
                turnIndicator.innerHTML = `<span class="text-primary"><i class="fa-regular fa-circle"></i></span> Turn`;
                if(gameMode === 'pvc') {
                     turnIndicator.innerHTML += aiMarker === 'circle' ? ` (AI)` : ` (You)`;
                }
            } else {
                turnIndicator.innerHTML = `<span class="text-secondary"><i class="fa-solid fa-x"></i></span> Turn`;
                if(gameMode === 'pvc') {
                     turnIndicator.innerHTML += aiMarker === 'x' ? ` (AI)` : ` (You)`;
                }
            }
        }

        function checkWin(currentClass) {
            return WINNING_COMBINATIONS.some(combination => {
                const isWin = combination.every(index => {
                    return cellElements[index].classList.contains(currentClass);
                });
                
                if (isWin) {
                    // Highlight winning cells
                    combination.forEach(index => {
                        cellElements[index].classList.add('winning-cell');
                    });
                }
                return isWin;
            });
        }

        function isDraw() {
            return [...cellElements].every(cell => {
                return cell.classList.contains(X_CLASS) || cell.classList.contains(CIRCLE_CLASS);
            });
        }

        function endGame(draw) {
            isGameActive = false;
            
            if (draw) {
                resultMessage.innerText = "It's a Draw!";
                resultSubtext.innerText = "No one wins this round.";
                winnerIcon.innerHTML = `<i class="fa-solid fa-handshake text-slate-500"></i>`;
                scores.ties++;
                scoreTiesEl.innerText = scores.ties;
                playSound(drawSound);
            } else {
                const winner = circleTurn ? "O" : "X";
                const isAIWin = (gameMode === 'pvc' && ((circleTurn && aiMarker === 'circle') || (!circleTurn && aiMarker === 'x')));
                
                resultMessage.innerText = `${winner} Wins!`;
                resultSubtext.innerText = isAIWin ? "The AI beat you this time." : "Great strategy and execution.";
                
                if (circleTurn) {
                    winnerIcon.innerHTML = `<i class="fa-regular fa-circle text-primary text-5xl"></i>`;
                    scores.o++;
                    scoreOEl.innerText = scores.o;
                } else {
                    winnerIcon.innerHTML = `<i class="fa-solid fa-x text-secondary text-5xl"></i>`;
                    scores.x++;
                    scoreXEl.innerText = scores.x;
                }
                playSound(winSound);
            }
            
            saveScores();
            
            // Show modal with slight delay for dramatic effect
            setTimeout(showModal, 700);
        }

        function makeAiMove() {
            const isAiTurn = (!circleTurn && aiMarker === 'x') || (circleTurn && aiMarker === 'circle');
            if (!isGameActive && gameMode === 'pvc' && isAiTurn) {
                // Re-enable game state internally for the move logic
                let targetCell;
                
                if (aiDifficulty === 'easy') {
                    targetCell = getRandomMove();
                } else if (aiDifficulty === 'moderate') {
                    targetCell = getModerateMove();
                } else {
                    targetCell = getBestMove();
                }

                if (targetCell) {
                    // Simulate click
                    isGameActive = true;
                    targetCell.click();
                }
            }
        }

        function getAvailableCells() {
            return [...cellElements].filter(cell => 
                !cell.classList.contains(X_CLASS) && !cell.classList.contains(CIRCLE_CLASS)
            );
        }

        function getRandomMove() {
            const availableCells = getAvailableCells();
            if (availableCells.length === 0) return null;
            const randomIndex = Math.floor(Math.random() * availableCells.length);
            return availableCells[randomIndex];
        }

        function getModerateMove() {
            const aiClass = aiMarker === 'circle' ? CIRCLE_CLASS : X_CLASS;
            const humanClass = userMarker === 'circle' ? CIRCLE_CLASS : X_CLASS;

            // 1. Check if AI can win
            let move = findWinningMove(aiClass);
            if (move) return move;

            // 2. Check if Player is about to win and block them
            move = findWinningMove(humanClass);
            if (move) return move;

            // 3. Otherwise, pick a random move
            return getRandomMove();
        }

        function findWinningMove(playerClass) {
            const availableCells = getAvailableCells();
            for (let cell of availableCells) {
                // Simulate move temporarily
                cell.classList.add(playerClass);
                
                const isWin = WINNING_COMBINATIONS.some(combination => {
                    return combination.every(index => {
                        return cellElements[index].classList.contains(playerClass);
                    });
                });
                
                // Undo simulated move
                cell.classList.remove(playerClass);
                
                if (isWin) return cell;
            }
            return null;
        }

        // Advanced AI using Minimax Algorithm
        function getBestMove() {
            const aiM = aiMarker === 'x' ? 'X' : 'O';
            const humanM = userMarker === 'x' ? 'X' : 'O';

            // Mapping board state to a simple array for minimax
            let boardArray = [...cellElements].map(cell => {
                if (cell.classList.contains(X_CLASS)) return 'X';
                if (cell.classList.contains(CIRCLE_CLASS)) return 'O';
                return '';
            });

            let bestScore = -Infinity;
            let moveIndex = -1;

            for (let i = 0; i < boardArray.length; i++) {
                if (boardArray[i] === '') {
                    boardArray[i] = aiM;
                    let score = minimax(boardArray, 0, false, aiM, humanM);
                    boardArray[i] = '';
                    
                    if (score > bestScore) {
                        bestScore = score;
                        moveIndex = i;
                    }
                }
            }

            return cellElements[moveIndex];
        }

        function minimax(board, depth, isMaximizing, aiM, humanM) {
            let result = checkWinnerForMinimax(board);
            if (result !== null) {
                if (result === aiM) return 10 - depth;
                if (result === humanM) return -10 + depth;
                if (result === 'tie') return 0;
            }

            if (isMaximizing) {
                let bestScore = -Infinity;
                for (let i = 0; i < board.length; i++) {
                    if (board[i] === '') {
                        board[i] = aiM;
                        let score = minimax(board, depth + 1, false, aiM, humanM);
                        board[i] = '';
                        bestScore = Math.max(score, bestScore);
                    }
                }
                return bestScore;
            } else {
                let bestScore = Infinity;
                for (let i = 0; i < board.length; i++) {
                    if (board[i] === '') {
                        board[i] = humanM;
                        let score = minimax(board, depth + 1, true, aiM, humanM);
                        board[i] = '';
                        bestScore = Math.min(score, bestScore);
                    }
                }
                return bestScore;
            }
        }

        function checkWinnerForMinimax(board) {
            for (let i = 0; i < WINNING_COMBINATIONS.length; i++) {
                const [a, b, c] = WINNING_COMBINATIONS[i];
                if (board[a] && board[a] === board[b] && board[a] === board[c]) {
                    return board[a];
                }
            }

            if (!board.includes('')) {
                return 'tie';
            }

            return null;
        }

        function setGameMode(mode) {
            gameMode = mode;
            if (mode === 'pvp') {
                btnPvp.classList.remove('bg-white', 'text-slate-700', 'dark:bg-slate-700', 'dark:text-slate-200');
                btnPvp.classList.add('bg-primary', 'text-white');
                
                btnPvc.classList.add('bg-white', 'text-slate-700', 'dark:bg-slate-700', 'dark:text-slate-200');
                btnPvc.classList.remove('bg-primary', 'text-white');
                
                aiDifficultyContainer.classList.add('hidden');
                playerMarkerContainer.classList.add('hidden');
            } else {
                btnPvc.classList.remove('bg-white', 'text-slate-700', 'dark:bg-slate-700', 'dark:text-slate-200');
                btnPvc.classList.add('bg-primary', 'text-white');
                
                btnPvp.classList.add('bg-white', 'text-slate-700', 'dark:bg-slate-700', 'dark:text-slate-200');
                btnPvp.classList.remove('bg-primary', 'text-white');
                
                aiDifficultyContainer.classList.remove('hidden');
                playerMarkerContainer.classList.remove('hidden');
            }
            updateScoreLabels();
            startGame(); // Restart game when mode changes
        }

        function setPlayerMarker(marker) {
            userMarker = marker;
            aiMarker = marker === 'x' ? 'circle' : 'x';
            
            if (marker === 'x') {
                btnPlayX.classList.add('bg-secondary', 'text-white', 'shadow');
                btnPlayX.classList.remove('text-slate-500', 'dark:text-slate-300');
                btnPlayO.classList.remove('bg-primary', 'text-white', 'shadow');
                btnPlayO.classList.add('text-slate-500', 'dark:text-slate-300');
            } else {
                btnPlayO.classList.add('bg-primary', 'text-white', 'shadow');
                btnPlayO.classList.remove('text-slate-500', 'dark:text-slate-300');
                btnPlayX.classList.remove('bg-secondary', 'text-white', 'shadow');
                btnPlayX.classList.add('text-slate-500', 'dark:text-slate-300');
            }
            updateScoreLabels();
            startGame();
        }

        function updateScoreLabels() {
            if (gameMode === 'pvc') {
                playerXLabel.innerText = userMarker === 'x' ? 'You (X)' : 'AI (X)';
                playerOLabel.innerText = userMarker === 'circle' ? 'You (O)' : 'AI (O)';
            } else {
                playerXLabel.innerText = 'Player (X)';
                playerOLabel.innerText = 'Player (O)';
            }
        }

        function setAiDifficulty(diff) {
            aiDifficulty = diff;
            
            // Reset all buttons to default unfocused state
            [btnEasy, btnModerate, btnHard].forEach(btn => {
                btn.classList.add('bg-white', 'text-slate-700', 'dark:bg-slate-700', 'dark:text-slate-200');
                btn.classList.remove('bg-green-500', 'bg-yellow-500', 'bg-red-500', 'text-white');
            });

            // Highlight selected button
            if (diff === 'easy') {
                btnEasy.classList.remove('bg-white', 'text-slate-700', 'dark:bg-slate-700', 'dark:text-slate-200');
                btnEasy.classList.add('bg-green-500', 'text-white');
            } else if (diff === 'moderate') {
                btnModerate.classList.remove('bg-white', 'text-slate-700', 'dark:bg-slate-700', 'dark:text-slate-200');
                btnModerate.classList.add('bg-yellow-500', 'text-white');
            } else {
                btnHard.classList.remove('bg-white', 'text-slate-700', 'dark:bg-slate-700', 'dark:text-slate-200');
                btnHard.classList.add('bg-red-500', 'text-white');
            }
            startGame();
        }

        function showModal() {
            resultModal.classList.remove('hidden');
            modalContent.classList.add('modal-enter');
        }

        function closeModal() {
            resultModal.classList.add('hidden');
            modalContent.classList.remove('modal-enter');
        }

        function playSound(audioElement) {
            audioElement.currentTime = 0;
            audioElement.play().catch(e => console.log("Audio playback prevented by browser policy", e));
        }

        function saveScores() {
            localStorage.setItem('ttt_scores', JSON.stringify(scores));
        }

        function loadSettings() {
            // Load Scores
            const savedScores = localStorage.getItem('ttt_scores');
            if (savedScores) {
                scores = JSON.parse(savedScores);
                scoreXEl.innerText = scores.x;
                scoreOEl.innerText = scores.o;
                scoreTiesEl.innerText = scores.ties;
            }

            // Load Theme
            if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
                themeToggle.checked = true;
            } else {
                document.documentElement.classList.remove('dark');
                themeToggle.checked = false;
            }
        }

        function resetScores() {
            // Simple confirmation replaced with direct action for smoother UX or custom modal
            // Since alert/confirm are disabled, we just reset it directly. 
            // In a larger app, a custom confirmation modal would go here.
            scores = { x: 0, o: 0, ties: 0 };
            scoreXEl.innerText = '0';
            scoreOEl.innerText = '0';
            scoreTiesEl.innerText = '0';
            saveScores();
            
            // Visual feedback
            const btnIcon = resetScoresButton.querySelector('i');
            btnIcon.classList.replace('fa-trash-can', 'fa-check');
            setTimeout(() => {
                btnIcon.classList.replace('fa-check', 'fa-trash-can');
            }, 1000);
        }

    </script>
</body>
